# =============================================================================
# Shared base image for all 10 services in this monorepo.
#
# Building 10 services that all need pnpm, node 24 and the same node_modules
# from scratch wastes ~10 minutes per `docker compose build`. This file
# extracts the work that is *identical* across services into reusable stages:
#
#   base   : pnpm + openssl installed once
#   deps   : workspace packages + pnpm install --frozen-lockfile (run once)
#   build  : shared packages compiled once (tsc --build)
#
# Per-service Dockerfiles are now tiny and only contain what's unique to that
# service (its own source tree, prisma generate if applicable, and the CMD).
#
# Result: ~5-8x faster cold builds, and a warm rebuild that re-uses the deps
# cache only has to re-fetch changed packages.
# =============================================================================

# ---------- base --------------------------------------------------------------
FROM node:24-alpine AS base

# openssl is needed at runtime by Prisma engines in most services; pnpm@10 is
# pinned to match the workspace's packageManager field.
RUN apk add --no-cache openssl
RUN npm install -g pnpm@10

WORKDIR /app

# Copy only the files pnpm needs to resolve dependencies. Bumping any of these
# invalidates the deps cache, so keep the set as small as possible.
COPY package.json ./
COPY pnpm-lock.yaml ./
COPY pnpm-workspace.yaml ./
COPY .pnpmrc ./
COPY tsconfig.base.json ./

# Copy the full source of the four shared packages — pnpm link-workspace needs
# their package.json + tsconfig to plan the build, and tsc later needs the .ts
# files. Services are NOT copied at this stage: they aren't needed for
# dependency resolution and would just bloat the layer.
COPY packages/shared-types/   ./packages/shared-types/
COPY packages/shared-utils/   ./packages/shared-utils/
COPY packages/shared-events/  ./packages/shared-events/
COPY packages/shared-middleware/ ./packages/shared-middleware/

# ---------- deps --------------------------------------------------------------
# One workspace-wide install, cached once for the whole monorepo.
# A subsequent service build that hasn't changed any package.json will skip
# this stage entirely (BuildKit cache hit) and go straight to its own tsc.
FROM base AS deps

# Mount pnpm's content-addressable store across all sibling service builds
# via the named `pnpm-cache` mount. This is the single most expensive step
# in the whole pipeline (~30-90s on a cold cache), so we want to do it once.
RUN --mount=type=cache,id=pnpm-cache,target=/root/.pnpm-store \
    pnpm install --frozen-lockfile

# ---------- shared-build ------------------------------------------------------
# Build the four shared packages ONCE; every service then COPYs the resulting
# dist + node_modules instead of running tsc on the same sources 10 times.
FROM deps AS shared-build

# `tsc --build` is dramatically faster than the legacy `pnpm -r run build`
# because it understands project references and skips up-to-date packages.
# We compile shared packages in topological order with --build.
RUN pnpm --filter "./packages/shared-types"        --filter "./packages/shared-utils" \
            --filter "./packages/shared-events"     --filter "./packages/shared-middleware" \
            run build
