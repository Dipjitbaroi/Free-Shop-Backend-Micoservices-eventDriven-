generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model Inventory {
  id              String   @id @default(uuid())
  productId       String
  variantId       String?  // For product variants
  freeItemId      String?  // For free items
  userId          String
  
  // Stock levels
  totalStock      Int      @default(0)
  reservedStock   Int      @default(0)
  availableStock  Int      @default(0) // totalStock - reservedStock
  
  // Alerts
  lowStockThreshold Int    @default(10)
  isLowStock      Boolean  @default(false)
  isOutOfStock    Boolean  @default(false)
  
  // Tracking
  lastRestockAt   DateTime?
  lastSoldAt      DateTime?
  
  reservations    StockReservation[]
  movements       StockMovement[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, variantId, freeItemId])
  @@index([productId])
  @@index([userId])
  @@index([isLowStock])
  @@index([isOutOfStock])
}

model StockReservation {
  id          String            @id @default(uuid())
  inventoryId String
  inventory   Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  
  orderId     String
  variantId   String?           // Support for product variants
  quantity    Int
  status      ReservationStatus @default(PENDING)
  
  expiresAt   DateTime?         // Auto-release after expiry
  releasedAt  DateTime?
  fulfilledAt DateTime?
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([inventoryId, orderId, variantId])
  @@index([orderId])
  @@index([status])
  @@index([expiresAt])
}

model StockMovement {
  id          String        @id @default(uuid())
  inventoryId String
  inventory   Inventory     @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  
  type        MovementType
  quantity    Int           // Positive for in, negative for out
  reason      String?
  reference   String?       // Order ID, adjustment ID, etc.
  
  previousStock Int
  newStock      Int
  
  performedBy String?
  
  createdAt   DateTime      @default(now())

  @@index([inventoryId])
  @@index([type])
  @@index([createdAt])
}

model InventoryAlert {
  id          String     @id @default(uuid())
  inventoryId String
  productId   String
  userId      String
  
  type        AlertType
  message     String
  isRead      Boolean    @default(false)
  
  createdAt   DateTime   @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model EventProcessingLog {
  id          String   @id @default(uuid())
  eventType   String   // e.g., ORDER_CREATED, PAYMENT_REFUNDED
  eventId     String   // Unique event identifier
  orderId     String?  // For order-related events
  
  status      String   @default("PROCESSING")  // PROCESSING, SUCCESS, FAILED, COMPENSATED
  payload     String?  // JSON payload for debugging
  error       String?  // Error message if failed
  
  processedAt DateTime @default(now())
  completedAt DateTime?
  
  createdAt   DateTime @default(now())

  @@unique([eventType, eventId])
  @@index([orderId])
  @@index([status])
  @@index([processedAt])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  FULFILLED
  RELEASED
  REFUNDED
  EXPIRED
}

enum MovementType {
  RESTOCK
  SALE
  RETURN
  ADJUSTMENT
  RESERVATION
  RELEASE
  INITIAL
  COMPENSATION
  REFUND
}

enum AlertType {
  LOW_STOCK
  OUT_OF_STOCK
  BACK_IN_STOCK
  RESERVATION_EXPIRED
}
